# ==============================================================================
# Phone AI Audit - 统一本地配置模板
#
# 请复制本文件为 `config.env`（已加入 .gitignore，不会上传到仓库）并按实际环境修改：
#   cp config.env.example config.env
# ==============================================================================

# --- 中转服务与部署配置（供 deploy/deploy-relay.sh 使用） ---
# 对外访问的域名（需已配置有效 TLS 证书）
RELAY_DOMAIN="audit.example.com"
# Nginx 对外暴露的 HTTPS / WSS 端口（需在云安全组与防火墙放行）
RELAY_PUBLIC_PORT="9876"
# 外部完整访问地址
RELAY_PUBLIC_URL="https://audit.example.com:9876"
# 中转服务在服务器本机监听的回环地址
RELAY_LISTEN_ADDR="127.0.0.1:8787"

# SSH 部署目标（可填 "ubuntu@你的服务器IP" 或 ~/.ssh/config 中的主机别名）
RELAY_SSH_HOST="ubuntu@your-server-ip"
# 可选：SSH 密码登录配置（推荐两项均留空，直接使用 SSH 密钥免密登录）
# 若必须使用密码登录，可填写密码或指向含 sshpass 的本地脚本路径（需已安装 sshpass）
RELAY_SSH_PASS=""
RELAY_SSH_PASS_SCRIPT=""
# 远端用户是否配置了免密 sudo（true = 直接 sudo；false = 通过 RELAY_SSH_PASS 传入 sudo -S）
RELAY_SUDO_NOPASSWD="true"

# 远端 Linux 服务器运行用户、部署目录、systemd 服务名与 Nginx 站点配置名
RELAY_REMOTE_USER="ubuntu"
RELAY_REMOTE_GROUP="ubuntu"
RELAY_REMOTE_DIR="/home/ubuntu/ai-audit-relay"
RELAY_SERVICE_NAME="ai-audit-relay"
RELAY_NGINX_SITE_NAME="ai-audit"

# 远端服务器 TLS 证书路径（例如 Let's Encrypt / Certbot 生成的证书）
RELAY_SSL_CERT="/etc/letsencrypt/live/audit.example.com/fullchain.pem"
RELAY_SSL_KEY="/etc/letsencrypt/live/audit.example.com/privkey.pem"
# 可选：Nginx SSL 附加配置（若未使用 Certbot 默认配置可留空）
RELAY_SSL_OPTIONS="/etc/letsencrypt/options-ssl-nginx.conf"
RELAY_SSL_DHPARAM="/etc/letsencrypt/ssl-dhparams.pem"

# --- Mac 客户端配置（供 deploy-relay.sh、mac-agent/scripts/install.sh、rollback.sh 使用） ---
# Mac 本地运行时配置文件路径
MAC_CONFIG_PATH="${HOME}/.config/ai-audit/config.json"
# 允许手机端「文件 / Git」页访问的 Mac 沙箱根目录（多个目录用英文逗号分隔）
MAC_FILE_ROOTS="${HOME}/workspace"
# macOS LaunchAgent 守护进程标识
MAC_LAUNCHD_LABEL="com.phone-ai-audit.agent"
# 可选：旧版 Codex 通知辅助程序路径（留空则跳过）
MAC_CODEX_LEGACY_NOTIFY_BIN=""

# --- Android 构建配置（供 android/build-apk.sh 与 android/app/build.gradle.kts 使用） ---
# Android 应用包名（仅需覆盖安装旧自定义包名时才需修改）
ANDROID_APPLICATION_ID="com.phoneaiaudit.app"
# 可选：首次打开 App 时预填的默认中转地址（留空则通过扫码配对填写）
ANDROID_DEFAULT_SERVER_URL=""
# 可选：本机 JDK 17 与 Android SDK 路径（留空则自动探测环境变量）
ANDROID_JAVA_HOME=""
ANDROID_HOME=""
# 可选：Gradle 拉取依赖时使用的本地 HTTP/HTTPS 代理（不需要代理请留空）
ANDROID_PROXY_HOST=""
ANDROID_PROXY_PORT=""
