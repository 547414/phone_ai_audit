# ==============================================================================
# Phone AI Audit - Unified Local Configuration Template
#
# Copy this file to `config.env` (gitignored) and fill in your own values:
#   cp config.env.example config.env
# ==============================================================================

# --- Relay Server & Deployment (used by deploy/deploy-relay.sh) ---
RELAY_DOMAIN="audit.example.com"
RELAY_PUBLIC_PORT="9876"
RELAY_PUBLIC_URL="https://audit.example.com:9876"
RELAY_LISTEN_ADDR="127.0.0.1:8787"

# SSH target for deployment (e.g., "ubuntu@203.0.113.10" or an alias in ~/.ssh/config)
RELAY_SSH_HOST="ubuntu@your-server-ip"
# Optional password auth via sshpass (leave both empty to use SSH keys, recommended)
RELAY_SSH_PASS=""
RELAY_SSH_PASS_SCRIPT=""
# Set to "true" if remote user has passwordless sudo; "false" uses RELAY_SSH_PASS for sudo -S
RELAY_SUDO_NOPASSWD="true"

# Remote Linux server user, directory, systemd service & Nginx site name
RELAY_REMOTE_USER="ubuntu"
RELAY_REMOTE_GROUP="ubuntu"
RELAY_REMOTE_DIR="/home/ubuntu/ai-audit-relay"
RELAY_SERVICE_NAME="ai-audit-relay"
RELAY_NGINX_SITE_NAME="ai-audit"

# TLS certificate paths on the relay server (e.g., Let's Encrypt / Certbot)
RELAY_SSL_CERT="/etc/letsencrypt/live/audit.example.com/fullchain.pem"
RELAY_SSL_KEY="/etc/letsencrypt/live/audit.example.com/privkey.pem"
# Optional Nginx SSL includes (leave empty if your server does not use Certbot's defaults)
RELAY_SSL_OPTIONS="/etc/letsencrypt/options-ssl-nginx.conf"
RELAY_SSL_DHPARAM="/etc/letsencrypt/ssl-dhparams.pem"

# --- Mac Agent (used by deploy-relay.sh, mac-agent/scripts/install.sh, rollback.sh) ---
MAC_CONFIG_PATH="${HOME}/.config/ai-audit/config.json"
# Comma-separated sandbox root directories accessible from the phone Files/Git tab
MAC_FILE_ROOTS="${HOME}/workspace"
# macOS LaunchAgent label
MAC_LAUNCHD_LABEL="com.phone-ai-audit.agent"
# Optional legacy Codex notify helper binary to invoke before ai-audit-hook
MAC_CODEX_LEGACY_NOTIFY_BIN=""

# --- Android Build (used by android/build-apk.sh and android/app/build.gradle.kts) ---
# Android applicationId (override only if you need to upgrade an existing custom app ID)
ANDROID_APPLICATION_ID="com.phoneaiaudit.app"
# Optional default relay URL pre-filled on first launch (leave empty to configure via QR pairing)
ANDROID_DEFAULT_SERVER_URL=""
# Optional JDK 17 / Android SDK paths (leave empty to auto-detect from environment)
ANDROID_JAVA_HOME=""
ANDROID_HOME=""
# Optional HTTP/HTTPS proxy for Gradle dependency downloads (leave empty if not needed)
ANDROID_PROXY_HOST=""
ANDROID_PROXY_PORT=""
