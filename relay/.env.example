# Runtime environment configuration for ai-audit-relay
# Copy to `relay/.env` (gitignored) for local runs, or deploy via `deploy/deploy-relay.sh`.

LISTEN_ADDR=127.0.0.1:8787
DB_PATH=./data/audit.db
MAC_TOKEN=replace-with-strong-random-mac-token
APP_TOKEN=replace-with-strong-random-app-token
PUBLIC_BASE_URL=https://audit.example.com:9876
