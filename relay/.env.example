# ai-audit-relay 运行时环境变量配置模板
# 本地运行请复制为 `relay/.env`（已加入 .gitignore），或通过 `deploy/deploy-relay.sh` 自动生成部署。

# 本机监听地址（建议仅监听回环地址，由 Nginx 负责 TLS 终结与反代）
LISTEN_ADDR=127.0.0.1:8787
# SQLite 数据库文件路径
DB_PATH=./data/audit.db
# Mac 守护进程鉴权密钥（请替换为高强度随机字符串，且不可与 APP_TOKEN 相同）
MAC_TOKEN=replace-with-strong-random-mac-token
# Android 手机端鉴权密钥（请替换为高强度随机字符串，且不可与 MAC_TOKEN 相同）
APP_TOKEN=replace-with-strong-random-app-token
# 对外公开访问地址
PUBLIC_BASE_URL=https://audit.example.com:9876
